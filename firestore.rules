rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /workspaces/{uid}/sessions/{sessionId}/ledgerEvents/{eventId} {
      function isWorkspaceOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isWorkspaceOwner();
      allow create: if isWorkspaceOwner()
        && request.resource.data.id == eventId
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.unit is string
        && request.resource.data.unit.size() > 0
        && request.resource.data.kind in ['RECEIVED', 'DISTRIBUTED', 'QUARANTINED', 'ADJUSTMENT'];
      allow update, delete: if false;
    }
  }
}
